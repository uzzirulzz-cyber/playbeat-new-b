# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB Atlas) ────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/playbeat?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
# Optional separate secret for admin tokens (falls back to JWT_SECRET)
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=12h

# ── CORS / URLs (comma-separated allowlist) ─────────────
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Encryption key for digital inventory payloads ───────
# Any long random string; it is hashed to a 32-byte key.
INVENTORY_ENCRYPTION_KEY=replace-with-long-random-string

# ── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Lemon Squeezy (optional) ────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ── Email (SMTP / transactional provider) ───────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PlayBeat Digital <no-reply@playbeat.digital>"

# ── Admin seed (used only by `npm run seed:admin`) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PlayBeat Admin

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
