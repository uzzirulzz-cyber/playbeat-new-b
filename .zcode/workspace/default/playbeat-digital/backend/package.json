{
  "name": "playbeat-api",
  "version": "1.0.0",
  "private": true,
  "description": "PlayBeat Digital API — Node.js/Express + MongoDB backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed:admin": "node src/seed/seedAdmin.js",
    "seed:demo": "node src/seed/seedDemo.js",
    "test": "jest --runInBand",
    "lint": "eslint src api tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "stripe": "^16.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 60000
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
