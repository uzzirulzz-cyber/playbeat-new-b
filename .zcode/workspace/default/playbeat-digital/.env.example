# PlayBeat Digital — root env reference.
# Copy backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env
# Never commit real secrets. See README.md for the full variable reference.

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:5000/api

# Backend (backend/.env) — see backend/.env.example for the complete list
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/playbeat
JWT_SECRET=change-me
